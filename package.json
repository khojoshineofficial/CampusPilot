{
  "name": "campuspilot",
  "version": "1.0.0",
  "description": "CampusPilot - Digital Campus Ecosystem",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "render:build": "cd server && npm install && cd ../client && npm install && npm run build",
    "render:start": "NODE_ENV=production node server/src/index.js",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/src/index.js",
    "install:all": "cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
